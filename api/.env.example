# Copia este archivo como .env para desarrollo local (`npm run dev` lo carga si existe).
# En Railway se definen en: servicio → Variables. NUNCA subas el .env al repo.

# JSON de la cuenta de servicio de club-odonteck, en una sola línea o en base64.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_STORAGE_BUCKET=club-odonteck.firebasestorage.app

# Bunny Stream (biblioteca de videos del club). La llave es la "Token Authentication Key"
# de la biblioteca, NO la API key.
BUNNY_LIBRARY_ID=725453
BUNNY_TOKEN_AUTH_KEY=
BUNNY_TOKEN_TTL_SECONDS=300

# Stripe. Usa llaves sk_test_ hasta el cambio definitivo.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MENSUAL=
STRIPE_PRICE_ANUAL=

APP_URL=https://www.odonteckconsulting.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://www.odonteckconsulting.com
PORT=8080
